# Telegram session-account userbot values from https://my.telegram.org
API_ID=123456
API_HASH=replace_me
TELETHON_SESSION_STRING=generate_locally_and_keep_secret

# BotFather bot token: Mini App launch, personal access keys, Smart Reports
BOT_TOKEN=123456:replace_me
PUBLIC_BASE_URL=https://your-service.onrender.com
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Neon/Postgres. The app normalizes postgres:// and postgresql:// URLs.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_SSL=true

# Telegram account IDs, comma-separated. Use your admin Telegram ID.
ADMIN_USER_IDS=123456789
# Existing unowned pairs are assigned to this user on first upgraded startup.
# Defaults to the first ADMIN_USER_IDS entry if blank.
LEGACY_OWNER_TELEGRAM_ID=

TIMEZONE=Asia/Yangon
DAILY_RUN_TIME=09:00
CUTOFF_TIME=23:00
RETRY_INTERVAL_MINUTES=60
SCAN_LIMIT_PER_PAIR=100
JOB_DELAY_SECONDS=5
SCHEDULER_POLL_SECONDS=120
REPORT_CHECK_INTERVAL_SECONDS=300
CLEANUP_INTERVAL_SECONDS=86400
HEALTH_PATH=/healthz
HOST=0.0.0.0
PORT=10000
