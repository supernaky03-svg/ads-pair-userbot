# Telegram API values from https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash_here
TELETHON_SESSION_STRING=your_string_session_here

# NeonDB/Postgres
# Both formats are accepted. The app normalizes postgresql:// to postgresql+asyncpg://
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Admins who can control the userbot from Saved Messages or control group
ADMIN_USER_IDS=123456789,987654321

# Control mode: saved or group
CONTROL_MODE=group
CONTROL_GROUP_ID=-1001234567890

# Daily run config
TIMEZONE=Asia/Yangon
DAILY_RUN_TIME=09:00
SCAN_LIMIT_PER_PAIR=100
JOB_DELAY_SECONDS=5
RETRY_INTERVAL_MINUTES=60
CUTOFF_TIME=23:00

# Render/UptimeRobot health server
HOST=0.0.0.0
PORT=10000
HEALTH_PATH=/healthz
